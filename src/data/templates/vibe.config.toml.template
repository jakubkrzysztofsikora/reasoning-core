# reasoning-core - Vibe CLI config (Phase 4).
# Generated by `rc init` (pip-installed wheel).
# is substituted to an absolute path at install time. The generated
# .vibe/config.toml is gitignored (per-machine).

[[mcp_servers]]
name = "hybrid-reasoner"
transport = "stdio"
command = "python3"
args = ["-m", "src.mcp_reasoner"]
cwd = "."
startup_timeout_sec = 20
tool_timeout_sec = 60

[hooks]
# post_agent_turn fires after each agent turn; retroactively flags missed
# gate_edit calls (Vibe lacks PreToolUse today).
post_agent_turn = "python3 -m src.hooks.post_batch_lang_audit"

[skills]
paths = [".vibe/skills", "~/.vibe/skills"]
