{
  "_note": "reasoning-core hooks. Generated by `rc init` from this project's GitHub source install. ${RC_PYTHON} resolves to the active Python interpreter. Re-running `rc init` merges missing reasoning-core hooks into this file.",
  "hooks": {
    "PreToolUse": [
      { "matcher": "Write",
        "hooks": [{ "type": "command", "command": "${RC_PYTHON} -m src.hooks.pre_plan_guard", "timeout": 15000 }] },
      { "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "${RC_PYTHON} -m src.hooks.pre_edit_guard", "timeout": 60000 }] },
      { "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "${RC_PYTHON} -m src.hooks.pre_bash_guard", "timeout": 5000 }] },
      { "matcher": "Task",
        "hooks": [{ "type": "command", "command": "${RC_PYTHON} -m src.hooks.pre_task_guard", "timeout": 5000 }] }
    ],
    "PostToolUse": [
      { "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "${RC_PYTHON} -m src.hooks.post_bash_revive", "timeout": 5000 },
          { "type": "command", "command": "${RC_PYTHON} -m src.hooks.post_bash_verification", "timeout": 10000 }
        ] },
      { "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "${RC_PYTHON} -m src.hooks.post_batch_lang_audit", "timeout": 5000 },
          { "type": "command", "command": "${RC_PYTHON} -m src.hooks.post_edit_check", "timeout": 15000 }
        ] }
    ],
    "SessionStart": [
      { "hooks": [
          { "type": "command", "command": "${RC_PYTHON} -m src.hooks.session_start_manifest", "timeout": 30000 },
          { "type": "command", "command": "${RC_PYTHON} -m src.hooks.session_resume_inject", "timeout": 5000 }
      ]}
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "${RC_PYTHON} -m src.hooks.session_resume_inject", "timeout": 5000 }] }
    ],
    "PreCompact": [
      { "hooks": [{ "type": "command", "command": "${RC_PYTHON} -m src.hooks.pre_compact_guard", "timeout": 5000 }] }
    ]
  },
  "mcpServers": {
    "hybrid-reasoner": {
      "type": "stdio",
      "command": "${RC_PYTHON}",
      "args": ["-m", "src.mcp_reasoner"]
    }
  }
}
