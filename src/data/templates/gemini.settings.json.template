{
  "_note": "reasoning-core hooks. Generated by `rc init` (pip-installed wheel).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "write_file",
        "hooks": [{ "type": "command", "command": "python3 -m src.hooks.pre_plan_guard", "timeout": 15000 }]
      },
      {
        "matcher": "write_file|edit_file|str_replace_editor",
        "hooks": [{ "type": "command", "command": "python3 -m src.hooks.pre_edit_guard", "timeout": 60000 }]
      },
      {
        "matcher": "run_shell_command",
        "hooks": [{ "type": "command", "command": "python3 -m src.hooks.pre_bash_guard", "timeout": 30000 }]
      },
      {
        "matcher": "task",
        "hooks": [{ "type": "command", "command": "python3 -m src.hooks.pre_task_guard", "timeout": 5000 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_shell_command",
        "hooks": [{ "type": "command", "command": "python3 -m src.hooks.post_bash_revive", "timeout": 5000 }]
      },
      {
        "matcher": "write_file|edit_file|str_replace_editor",
        "hooks": [{ "type": "command", "command": "python3 -m src.hooks.post_batch_lang_audit", "timeout": 5000 }]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python3 -m src.hooks.session_start_manifest", "timeout": 30000 },
          { "type": "command", "command": "python3 -m src.hooks.session_resume_inject", "timeout": 5000 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "python3 -m src.hooks.session_resume_inject", "timeout": 5000 }]
      }
    ],
    "PreCompact": [
      {
        "hooks": [{ "type": "command", "command": "python3 -m src.hooks.pre_compact_guard", "timeout": 5000 }]
      }
    ]
  },
  "mcpServers": {
    "hybrid-reasoner": {
      "command": "python3",
      "args": ["-m", "src.mcp_reasoner"],
      "cwd": ".",
      "env": {}
    }
  }
}
