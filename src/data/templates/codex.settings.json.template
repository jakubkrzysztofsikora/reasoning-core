{
  "description": "reasoning-core hooks for OpenAI Codex CLI. Generated by `rc init` from the pip-installed wheel; resolves into the same Python interpreter as the `rc` console script. Re-running `rc init` is a no-op.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m src.hooks.pre_edit_guard",
            "timeout": 60000,
            "statusMessage": "reasoning-core: scoring proposed edit"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m src.hooks.pre_bash_guard",
            "timeout": 30000,
            "statusMessage": "reasoning-core: scoring proposed bash"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m src.hooks.post_bash_revive",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m src.hooks.post_batch_lang_audit",
            "timeout": 5000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m src.hooks.session_start_manifest",
            "timeout": 30000
          },
          {
            "type": "command",
            "command": "python3 -m src.hooks.session_resume_inject",
            "timeout": 5000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m src.hooks.session_resume_inject",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m src.hooks.pre_compact_guard",
            "timeout": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m src.hooks.stop_reconcile",
            "timeout": 30000,
            "statusMessage": "reasoning-core: reconcile gate_edit vs git"
          }
        ]
      }
    ]
  }
}
