+const projectEditQueues = new Map<string, Promise<void>>();
+async function acquireProjectEditLock(cwd: string, signal?: AbortSignal): Promise<() => void> {
+ const key = realpathSync(cwd);
+ const previous = projectEditQueues.get(key) ?? Promise.resolve();
+ let unlock!: () => void;
+ const held = new Promise<void>(resolve => { unlock = resolve; });
+ const queued = previous.then(() => held);
+ projectEditQueues.set(key, queued);
+ await previous;
+ const release = () => {
+   unlock();
+   if (projectEditQueues.get(key) === queued) projectEditQueues.delete(key);
+ };
+ if (signal?.aborted) { release(); throw new Error("Native edit cancelled while queued"); }
+ return release;
+}
