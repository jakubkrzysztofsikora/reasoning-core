+ async emitNativeEdit(
+   event: NativeEditPrepareEvent | NativeEditResultEvent,
+   sessionId: string | null, agentId: string | null, signal?: AbortSignal,
+ ): Promise<NativeEditApproval | undefined> {
+   const denied: NativeEditApproval = { allowed: false,
+     finalInputSha256: event.type === "native_edit_prepare" ? event.batch.finalInputSha256 : "" };
+   if (!sessionId || !agentId) return denied;
+   const agent = this.createContext().agent;
+   const ctx = this.createContext(undefined, undefined, agentId === agent.id ? agent
+     : { kind: "sub", id: agentId, name: agentId, depth: agent.depth + 1, parentId: agent.id });
+   ctx.sessionManager = new Proxy(ctx.sessionManager, {
+     get(target, property) {
+       if (property === "getSessionId") return () => sessionId;
+       const value = Reflect.get(target, property);
+       return typeof value === "function" ? value.bind(target) : value;
+     },
+   });
+   let handled = false;
+   for (const ext of this.extensions) {
+     for (const handler of ext.handlers.get(event.type) ?? []) {
+       handled = true;
+       const result = await this.#runHandlerWithTimeout(handler, event, ctx, ext, 40000,
+         () => denied, signal) as NativeEditApproval | undefined;
+       if (event.type === "native_edit_prepare" && (!result || result.allowed !== true
+         || result.finalInputSha256 !== event.batch.finalInputSha256)) return denied;
+       if (event.type === "native_edit_result" && result === denied)
+         throw new Error("Native edit receipt handler failed");
+     }
+   }
+   if (event.type === "native_edit_prepare")
+     return handled && !signal?.aborted ? { allowed: true, finalInputSha256: event.batch.finalInputSha256 } : denied;
+ }
