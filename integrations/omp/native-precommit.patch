+/// Complete final native candidates passed to the host before any write.
+#[derive(Debug, Clone)]
+pub struct PreparedCandidate {
+	pub path:                   PathBuf,
+	pub operation:              String,
+	pub before_src:             Option<String>,
+	pub after_src:              Option<String>,
+	pub expected_before_sha256: Option<String>,
+	resolved:                   PathBuf,
+}
+
+#[derive(Debug, Clone)]
+pub struct PreparedEdit {
+	pub final_input_sha256: String,
+	pub candidates:         Vec<PreparedCandidate>,
+}
+
+fn sha256(text: &str) -> String {
+	format!("{:x}", Sha256::digest(text.as_bytes()))
+}
+
+// Resolve through the deepest existing ancestor, including missing parents.
+fn source_path(path: &Path) -> EditResult<PathBuf> {
+	if let Ok(resolved) = std::fs::canonicalize(path) {
+		return Ok(resolved);
+	}
+	if std::fs::symlink_metadata(path).is_ok() {
+		return Err(EditError::apply("Unresolvable prepared source"));
+	}
+	let parent = path
+		.parent()
+		.ok_or_else(|| EditError::apply("Invalid prepared path"))?;
+	let name = path
+		.file_name()
+		.ok_or_else(|| EditError::apply("Invalid prepared path"))?;
+	Ok(source_path(parent)?.join(name))
+}
+
+fn read_source(path: &Path) -> EditResult<Option<String>> {
+	match std::fs::read_to_string(path) {
+		Ok(text) => Ok(Some(text)),
+		Err(err)
+			if err.kind() == std::io::ErrorKind::NotFound
+				&& std::fs::symlink_metadata(path).is_err() =>
+		{
+			Ok(None)
+		},
+		Err(err) => Err(EditError::apply(format!("Unreadable prepared source: {err}"))),
+	}
+}
+
+impl PreparedCandidate {
+	fn new(
+		path: PathBuf,
+		before_src: Option<String>,
+		after_src: Option<String>,
+	) -> EditResult<Self> {
+		let resolved = source_path(&path)?;
+		let expected_before_sha256 = before_src.as_deref().map(sha256);
+		let candidate = Self {
+			path,
+			operation: if after_src.is_some() {
+				"write"
+			} else {
+				"delete"
+			}
+			.into(),
+			before_src,
+			after_src,
+			expected_before_sha256,
+			resolved,
+		};
+		candidate.verify()?;
+		Ok(candidate)
+	}
+
+	fn verify(&self) -> EditResult<()> {
+		if source_path(&self.path)? != self.resolved || read_source(&self.path)? != self.before_src {
+			return Err(EditError::apply("Prepared source changed before commit"));
+		}
+		Ok(())
+	}
+}
+
+impl PreparedEdit {
+	fn from_staged(input: &str, staged: &[StagedFile]) -> EditResult<Self> {
+		let mut candidates = Vec::new();
+		let mut paths = HashSet::new();
+		for file in staged {
+			if file.op == FileOp::Noop {
+				continue;
+			}
+			let after = if file.op == FileOp::Delete {
+				None
+			} else {
+				file.persisted.clone()
+			};
+			if let Some(destination) = &file.move_to {
+				candidates.push(PreparedCandidate::new(
+					file.absolute.clone(),
+					file.before_raw.clone(),
+					None,
+				)?);
+				candidates.push(PreparedCandidate::new(
+					destination.absolute.clone(),
+					read_source(&destination.absolute)?,
+					after,
+				)?);
+			} else {
+				candidates.push(PreparedCandidate::new(
+					file.absolute.clone(),
+					file.before_raw.clone(),
+					after,
+				)?);
+			}
+		}
+		for candidate in &candidates {
+			if !paths.insert(candidate.resolved.clone()) {
+				return Err(EditError::apply("Duplicate prepared destination"));
+			}
+		}
+		Ok(Self { final_input_sha256: sha256(input), candidates })
+	}
+}
