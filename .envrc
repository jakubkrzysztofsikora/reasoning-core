#!/usr/bin/env bash
# direnv config for reasoning-core. Loads Claude Code + Scaleway + sidecar
# env scoped to this repo so it doesn't leak into other Claude sessions.
#
# Activate once with `direnv allow` in this directory.
# Private overrides go in .envrc.local (gitignored) — see end of file.
#
# Layers:
#   1. Python venv on PATH so `python3` resolves to .venv/bin/python3.
#   2. Sidecar tuning (S2_*).
#   3. Hook policy posture (RC_*).
#   4. Scaleway / y-router proxy for Claude Code (ANTHROPIC_*).
# Anything you don't want versioned (API keys, personal RC overrides) lives
# in .envrc.local which is sourced last and gitignored.

# --- 1. venv -----------------------------------------------------------------
# `layout python` is direnv stdlib; loads .venv/bin/activate semantics.
if [[ -d .venv ]]; then
  source_env_if_exists .venv/bin/activate || PATH_add .venv/bin
fi
# Help local imports of `src.*` (the hook scripts add this themselves, but
# having it in env means ad-hoc `python3 -c "import src.s2_core"` works.)
export PYTHONPATH="$(pwd)${PYTHONPATH:+:$PYTHONPATH}"

# --- 2. Sidecar tuning -------------------------------------------------------
export S2_DEVICE="${S2_DEVICE:-cpu}"
export S2_TIMEOUT="${S2_TIMEOUT:-60}"          # CPU Mamba can take ~30s
export S2_FAIL_CLOSED="${S2_FAIL_CLOSED:-1}"   # block when sidecar down
# Default checkpoint already pinned in src/ssm_backbone.py; uncomment to swap:
# export S2_SSM_CHECKPOINT="state-spaces/mamba2-130m"
#
# Regression thresholds — env-overridable (defaults baked into src/s2_core.py):
#   S2_AIS_THRESHOLD        AIS floor; ais < this => regression. Default 0.4.
#   S2_COHERENCE_THRESHOLD  Normalized coherence_delta ceiling. Default 1.5.
#   S2_RISK_DIM_THRESHOLD   Per-risk-dim ceiling for the 8-dim vector. Default 0.9.
# Per-file-kind thresholds (plan_md, doc_md, test_code, config) live in the
# _KIND_THRESHOLDS dict in s2_core.py; only the source_code defaults are
# overridable via the vars above. Set non-default values in .envrc.local.

# Pin HF cache to a project-local dir so model downloads don't pollute
# ~/.cache and other repos can't accidentally share corrupted weights.
export HF_HOME="${HF_HOME:-$(pwd)/.cache/huggingface}"

# --- 3. Hook policy posture --------------------------------------------------
# Make plan-guard escalate warnings to exit 2 (default is warn-only stderr).
export RC_PLAN_BLOCK="${RC_PLAN_BLOCK:-1}"

# Do NOT export RC_ALLOW_GUARD_EDIT or RC_ALLOW_SUBAGENT_GUARD_EDIT here.
# Those are intentional manual-override knobs — set them transiently for
# one shell when you actually need to edit guard files:
#   RC_ALLOW_GUARD_EDIT=1 claude

# --- 4. Eval toggles ---------------------------------------------------------
# RC_LIVE / RC_EVAL_STUB_CLAUDE are per-invocation; not exported globally.
# Same for ANTHROPIC_API_KEY — keep that in .envrc.local.

# --- 5. Scaleway / y-router (gated on the proxy actually being up) ---------
# Earlier versions exported ANTHROPIC_BASE_URL=http://localhost:8787
# unconditionally — that broke `claude` when y-router wasn't running
# (ConnectionRefused). Now we only set the proxy vars when:
#   (a) `scw` is installed and has a secret-key for profile `newprofile`, AND
#   (b) something is actually listening on the y-router port (default 8787).
# If either is false, leave Claude on its default ANTHROPIC endpoint
# (operator's ANTHROPIC_API_KEY from .envrc.local handles auth).
YROUTER_PORT="${YROUTER_PORT:-8787}"
_yrouter_listening() {
  # No nc/lsof needed — bash builtin /dev/tcp probe with a 0.3s timeout.
  (timeout 0.3 bash -c "exec 3<>/dev/tcp/127.0.0.1/${YROUTER_PORT}") >/dev/null 2>&1
}
if command -v scw >/dev/null 2>&1 && _yrouter_listening; then
  if SCALEWAY_KEY="$(scw config get secret-key --profile newprofile 2>/dev/null)" && [[ -n "$SCALEWAY_KEY" ]]; then
    export SCALEWAY_API_KEY="$SCALEWAY_KEY"
    export ANTHROPIC_BASE_URL="${ANTHROPIC_BASE_URL:-http://localhost:${YROUTER_PORT}}"
    export ANTHROPIC_AUTH_TOKEN="$SCALEWAY_API_KEY"
    export ANTHROPIC_MODEL="${ANTHROPIC_MODEL:-devstral-2-123b-instruct-2512}"
    export ANTHROPIC_SMALL_FAST_MODEL="${ANTHROPIC_SMALL_FAST_MODEL:-devstral-2-123b-instruct-2512}"
    unset SCALEWAY_KEY
    echo "         ANTHROPIC routed through y-router :${YROUTER_PORT} (Scaleway)"
  fi
else
  # Defensive: scrub any stale proxy env from a parent shell so Claude
  # doesn't try to connect to a dead y-router.
  unset ANTHROPIC_BASE_URL
  unset ANTHROPIC_AUTH_TOKEN
fi

# --- 6. Local overrides (gitignored) ----------------------------------------
# Place non-versioned secrets and personal toggles in .envrc.local:
#   export ANTHROPIC_API_KEY=sk-ant-...   # for live eval runs
#   export S2_SSM_CHECKPOINT=foo/bar
#   export RC_PLAN_BLOCK=0                # to re-enable warn-only locally
if [[ -f .envrc.local ]]; then
  source_env .envrc.local
fi

# --- summary -----------------------------------------------------------------
# Visible feedback on `cd` so you know the env loaded.
echo "[direnv] reasoning-core env loaded:"
echo "         python: $(command -v python3 2>/dev/null || echo 'not found')"
echo "         S2_FAIL_CLOSED=$S2_FAIL_CLOSED  S2_TIMEOUT=$S2_TIMEOUT"
echo "         RC_PLAN_BLOCK=$RC_PLAN_BLOCK"
echo "         ANTHROPIC_BASE_URL=${ANTHROPIC_BASE_URL:-<unset>}"
