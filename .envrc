#!/usr/bin/env bash
# direnv config for reasoning-core. Loads Claude Code + Scaleway + sidecar
# env scoped to this repo so it doesn't leak into other Claude sessions.
#
# Activate once with `direnv allow` in this directory.
# Private overrides go in .envrc.local (gitignored) — see end of file.
#
# Layers:
#   1. Python venv on PATH so `python3` resolves to .venv/bin/python3.
#   2. Sidecar tuning (S2_*).
#   3. Hook policy posture (RC_*).
#   4. Scaleway / y-router proxy for Claude Code (ANTHROPIC_*).
# Anything you don't want versioned (API keys, personal RC overrides) lives
# in .envrc.local which is sourced last and gitignored.

# --- 1. venv -----------------------------------------------------------------
# `layout python` is direnv stdlib; loads .venv/bin/activate semantics.
if [[ -d .venv ]]; then
  source_env_if_exists .venv/bin/activate || PATH_add .venv/bin
fi
# Repo-local rc CLI shim. Without this, `rc status` 404s after a fresh clone.
PATH_add bin
# Help local imports of `src.*` (the hook scripts add this themselves, but
# having it in env means ad-hoc `python3 -c "import src.s2_core"` works.)
export PYTHONPATH="$(pwd)${PYTHONPATH:+:$PYTHONPATH}"

# --- 2. Sidecar tuning -------------------------------------------------------
export S2_DEVICE="${S2_DEVICE:-cpu}"
export S2_TIMEOUT="${S2_TIMEOUT:-60}"          # CPU Mamba can take ~30s
# Hard client-side cap on /score POST. Phase 0 standard: 1500 ms. On timeout
# the gate invokes real symbolic fallback (rule_engine + lang_lock +
# plan_grounding) and audits reason="hard_cap_exceeded" / signal_source=
# "symbolic_fallback". Audit 2026-06-01 §1.4 showed p99=60s without any cap.
export S2_HARD_CAP_MS="${S2_HARD_CAP_MS:-1500}"
export S2_FAIL_CLOSED="${S2_FAIL_CLOSED:-1}"   # block when sidecar down
export S2_PORT="${S2_PORT:-8765}"              # mirror eval-setups/B/.envrc
# Host is 64 GiB; 7B Mamba-Codestral Q2_K forward peaks ~8-12 GiB.
# Cap at 25 GiB — well under host total, well above worst-case forward.
export S2_MEM_LIMIT_GB="${S2_MEM_LIMIT_GB:-25}"
# Default checkpoint already pinned in src/ssm_backbone.py; uncomment to swap:
# export S2_SSM_CHECKPOINT="state-spaces/mamba2-130m"
#
# Regression thresholds — env-overridable (defaults baked into src/s2_core.py):
#   S2_AIS_THRESHOLD        AIS floor; ais < this => regression. Default 0.4.
#   S2_COHERENCE_THRESHOLD  coherence_delta (chord, [0,2]) ceiling. Default 0.09 (empirical p95 — see audit 2026-06-01).
#   S2_RISK_DIM_THRESHOLD   Per-risk-dim ceiling for the 8-dim vector. Default 0.9.
# Per-file-kind thresholds (plan_md, doc_md, test_code, config) live in the
# _KIND_THRESHOLDS dict in s2_core.py; only the source_code defaults are
# overridable via the vars above. Set non-default values in .envrc.local.

# HF cache — mirror Setup B (~/.cache/huggingface) so weights don't get
# downloaded twice across the repo and the eval worktrees.
export HF_HOME="${HF_HOME:-$HOME/.cache/huggingface}"

# --- Cato VPN TLS interception ----------------------------------------------
# Cato Networks injects its own root CA into TLS chains; certifi's pinned
# bundle rejects this as "self-signed certificate in certificate chain".
# Build ~/.cache/reasoning-core/ca-bundle.pem = certifi + Cato root once,
# point urllib3 / requests / transformers / curl at it.
_RC_CA_BUNDLE="$HOME/.cache/reasoning-core/ca-bundle.pem"
if [[ ! -s "$_RC_CA_BUNDLE" ]] && command -v security >/dev/null 2>&1; then
  mkdir -p "$(dirname "$_RC_CA_BUNDLE")"
  _RC_CERTIFI="$(python3 -c 'import certifi; print(certifi.where())' 2>/dev/null)"
  if [[ -f "$_RC_CERTIFI" ]]; then
    cat "$_RC_CERTIFI" > "$_RC_CA_BUNDLE"
    security find-certificate -a -p -c "Cato Networks" /Library/Keychains/System.keychain >> "$_RC_CA_BUNDLE" 2>/dev/null || true
  fi
fi
if [[ -s "$_RC_CA_BUNDLE" ]]; then
  export SSL_CERT_FILE="$_RC_CA_BUNDLE"
  export REQUESTS_CA_BUNDLE="$_RC_CA_BUNDLE"
  export CURL_CA_BUNDLE="$_RC_CA_BUNDLE"
fi
unset _RC_CA_BUNDLE _RC_CERTIFI

# --- 3. Hook policy posture --------------------------------------------------
# Phase 0 honest opt-in: RC_MODE=advise means log/warn only, never block.
# Promote to copilot (block on contract/oracle/rule failures) with:
#   rc enable-enforcement
# Autopilot (block + auto-repair) remains explicitly opt-in.
export RC_MODE="${RC_MODE:-advise}"
export RC_SHADOW_MODE="${RC_SHADOW_MODE:-1}"   # 1 = log-only; 0 = enforce
export RC_PLAN_BLOCK="${RC_PLAN_BLOCK:-0}"     # 1 = plan-guard warnings escalate to exit 2

# Do NOT export RC_ALLOW_GUARD_EDIT or RC_ALLOW_SUBAGENT_GUARD_EDIT here.
# Those are intentional manual-override knobs — set them transiently for
# one shell when you actually need to edit guard files:
#   RC_ALLOW_GUARD_EDIT=1 claude

# --- 4. Eval toggles ---------------------------------------------------------
# RC_LIVE / RC_EVAL_STUB_CLAUDE are per-invocation; not exported globally.
# Same for ANTHROPIC_API_KEY — keep that in .envrc.local.

# --- 4b. Iter-2 / iter-3 feature flags ---------------------------------------
# Mirror of /Users/jakubsikora/eval-setups/B/.envrc structure. Default operator
# posture is shadow-mode-ON / RC_MODE=advise (honest opt-in, Phase 0).
# Promote to copilot with `rc enable-enforcement` after a 48-hour shadow report.
#
# Wiring status (all SHIPPED as of 2026-05-06):
#   RC_SHADOW_MODE       — decision sink (pre_edit_guard.py)
#   RC_MOCK_DETECTOR     — _mock_detector.py (P1 ship 1724810)
#   RC_PLAN_QUALITY      — _plan_quality.py (P2 ship 1724810)
#   RC_LANG_LOCK         — pre_edit_guard.py (P3 ship 54c6e57)
#   RC_REASONER_BACKEND  — gen_client.py (P5 ship aece0e6)
#   RC_GEN_BUDGET_MS     — gen_client.py (P5)
#   RC_GEN_URL           — Scaleway/local switch (80b5543)
#   RC_GEN_API_KEY       — Bearer auth for hosted critic (80b5543)
#   RC_CALIBRATION_ENABLED — _calibration_gate.py (P7 round-3 b7f0517); default OFF
#   RC_RECALIBRATE_POLL_S  — _supervisor_recalibrate.py (5313498)
#   RC_BROKER_PORT       — _supervisor_broker.py /health aggregator
export RC_MOCK_DETECTOR="${RC_MOCK_DETECTOR:-1}"
# RC_PLAN_QUALITY=0 by default until calibrated; flip to 1 in measurement
# configs (Setup B) after corpus-fit per LLM-sci recommendation.
export RC_PLAN_QUALITY="${RC_PLAN_QUALITY:-0}"
export RC_LANG_LOCK="${RC_LANG_LOCK:-1}"
export RC_SHADOW_MODE="${RC_SHADOW_MODE:-1}"   # 1 = log-only. Honors parent override.
export RC_REASONER_BACKEND="${RC_REASONER_BACKEND:-mlx}"
export RC_GEN_BUDGET_MS="${RC_GEN_BUDGET_MS:-2500}"
# Audit log lives under XDG state by default; override via RC_AUDIT_ROOT for tests.
export RC_AUDIT_RETENTION_DAYS="${RC_AUDIT_RETENTION_DAYS:-90}"

# --- 4c. Iter-3 calibration knobs (P7 round-3 b7f0517 + 5313498) -------------
# Mahalanobis gate (default OFF; flips to 1 only after Phase 3.5 v3 cross-family
# corpus is built and re-fit kappa >= 0.6 / CI lower >= 0.5 lands).
export RC_CALIBRATION_ENABLED="${RC_CALIBRATION_ENABLED:-0}"
# Supervisor watcher poll for recalibrate.signal; hot-reloadable per tick.
export RC_RECALIBRATE_POLL_S="${RC_RECALIBRATE_POLL_S:-60}"
# Broker /health aggregator HTTP port.
export RC_BROKER_PORT="${RC_BROKER_PORT:-8764}"

# --- 4d. Iter-3 levers (default ON in advise mode — see docs/iter3-levers.md) -
# Three default-off levers shipped in iter-3 phases 1-5 (commits 73eb55a,
# c397141, c419a88, c11d9ac, 214a258). Reasoning-core ships levers; the eval
# team turns them on in eval-setups/B/.envrc. Local dev defaults stay off.
#
# RC_BEST_EFFORT_SPEC (Phase 2, src/hooks/session_start_best_effort.py):
#   When =1, SessionStart hook emits the iter-3 minimal overlay
#   "Never ship a DIVERGENCES.md alone." into the session's system context.
#   Single-factor (license-removal sentence ONLY); recipe variant deferred to
#   iter-4 under a separate env var. =2 reserved for iter-4 no-op placebo.
#   Eval team must register the hook in their settings.local.json
#   (see docs/iter3-levers.md §"SessionStart hook registration").
export RC_BEST_EFFORT_SPEC="${RC_BEST_EFFORT_SPEC:-1}"   # default-on per audit 2026-06-01 §B4
#
# RC_PLAN_GROUNDING (Phase 3, src/hooks/_dispatch.py:gate_plan_grounding):
#   =0 disabled. =1 warn (Phase 0 default in advise mode) — stderr advisory +
#   audit event tagged signal_source=plan_grounding decision=warn (NOT visible
#   to agent — neutralizes the path-stuffing reward-hacking failure mode). =2
#   hard block — exit 2 with audit_log.record_block. PLAN.md itself always
#   passes; gate cannot block plan revision.
export RC_PLAN_GROUNDING="${RC_PLAN_GROUNDING:-1}"   # default 1 (warn-only) per audit 2026-06-01 §B4. =0 silences, =2 blocks.
#
# RC_PRM_GATE (audit 2026-06-01 §B1, src/hooks/_dispatch.py:gate_prm):
#   =0 disabled (default — no training data yet). =1 emits a
#   signal_source="prm" audit event per Edit with prm_score in [0,1].
#   Measurement-only; never blocks until a calibrated threshold lands.
export RC_PRM_GATE="${RC_PRM_GATE:-0}"
#
# RC_RUN_DIR (Phase 3): optional override for PLAN.md resolution.
# Precedence: RC_RUN_DIR > CLAUDE_PROJECT_DIR > cwd. Eval spawner sets this
# per run; local dev typically leaves it unset (CLAUDE_PROJECT_DIR wins).

# --- 5. Scaleway / y-router (gated on the proxy actually being up) ---------
# Earlier versions exported ANTHROPIC_BASE_URL=http://localhost:8787
# unconditionally — that broke `claude` when y-router wasn't running
# (ConnectionRefused). Now we only set the proxy vars when:
#   (a) `scw` is installed and has a secret-key for profile `newprofile`, AND
#   (b) something is actually listening on the y-router port (default 8787).
# If either is false, leave Claude on its default ANTHROPIC endpoint
# (operator's ANTHROPIC_API_KEY from .envrc.local handles auth).
YROUTER_PORT="${YROUTER_PORT:-8787}"
_yrouter_listening() {
  # No nc/lsof needed — bash builtin /dev/tcp probe with a 0.3s timeout.
  (timeout 0.3 bash -c "exec 3<>/dev/tcp/127.0.0.1/${YROUTER_PORT}") >/dev/null 2>&1
}
if command -v scw >/dev/null 2>&1 && _yrouter_listening; then
  if SCALEWAY_KEY="$(scw config get secret-key --profile newprofile 2>/dev/null)" && [[ -n "$SCALEWAY_KEY" ]]; then
    export SCALEWAY_API_KEY="$SCALEWAY_KEY"
    export ANTHROPIC_BASE_URL="${ANTHROPIC_BASE_URL:-http://localhost:${YROUTER_PORT}}"
    export ANTHROPIC_AUTH_TOKEN="$SCALEWAY_API_KEY"
    export ANTHROPIC_MODEL="${ANTHROPIC_MODEL:-devstral-2-123b-instruct-2512}"
    export ANTHROPIC_SMALL_FAST_MODEL="${ANTHROPIC_SMALL_FAST_MODEL:-devstral-2-123b-instruct-2512}"
    unset SCALEWAY_KEY
    echo "         ANTHROPIC routed through y-router :${YROUTER_PORT} (Scaleway)"
  fi
else
  # Defensive: scrub any stale proxy env from a parent shell so Claude
  # doesn't try to connect to a dead y-router.
  unset ANTHROPIC_BASE_URL
  unset ANTHROPIC_AUTH_TOKEN
fi

# --- 6. Local overrides (gitignored) ----------------------------------------
# Place non-versioned secrets and personal toggles in .envrc.local:
#   export ANTHROPIC_API_KEY=sk-ant-...   # for live eval runs
#   export S2_SSM_CHECKPOINT=foo/bar
#   export RC_PLAN_BLOCK=0                # to re-enable warn-only locally
if [[ -f .envrc.local ]]; then
  source_env .envrc.local
fi

# --- Iter-3 lever self-check (adopter sweep round-5) ---
# Catch env-var theatre: lever set to 1 but corresponding hook never
# registered. WARN loudly at direnv load so the operator notices BEFORE
# any session starts. Searches for hook registration in the standard
# Claude Code settings locations: project-local .claude/, then user-level
# ~/.claude/. Tightened regex matches the actual command-line shape so
# substring false-positives (filenames containing the substring, JSON
# `_note` keys, etc.) cannot mask a missing registration.
_RC_LEVER_WARN() {
  local hook_name="$1" env_var="$2"
  local found=0
  for cfg in .claude/settings.local.json .claude/settings.json \
             "$HOME/.claude/settings.local.json" "$HOME/.claude/settings.json"; do
    [[ -f "$cfg" ]] || continue
    if grep -qE "\"command\"[^\"]*\"[^\"]*${hook_name}\"" "$cfg" 2>/dev/null; then
      found=1
      break
    fi
  done
  if [[ "$found" == "0" ]]; then
    echo "[direnv] WARN: $env_var=1 but $hook_name not registered in any settings.local.json — lever is INERT"
  fi
}
if [[ "$RC_BEST_EFFORT_SPEC" == "1" ]]; then
  _RC_LEVER_WARN "session_start_best_effort.py" "RC_BEST_EFFORT_SPEC"
fi
if [[ "$RC_PLAN_GROUNDING" == "1" || "$RC_PLAN_GROUNDING" == "2" ]]; then
  _RC_LEVER_WARN "pre_edit_guard.py" "RC_PLAN_GROUNDING"
fi
unset -f _RC_LEVER_WARN


export RC_EMBEDDER=codestral-mamba-gguf      # mamba-130m | codestral-mamba | bge-code | unixcoder-base
export RC_CODESTRAL_GGUF_FILE=Mamba-Codestral-7B-v0.1-Q2_K.gguf
# Cap SSM activation buffers so the Mamba-2 forward pass stays under the 16 GiB
# watchdog. 2048 tokens covers a typical code diff (~600 tok avg).
export RC_GGUF_N_CTX="${RC_GGUF_N_CTX:-2048}"
export RC_MISTRALAI_MAMBA_CODESTRAL_7B_V0_1_REVISION=4f086c08c1e0f07bdc50ca25125dbbf7475d21da
export RC_GABRIELLARSON_MAMBA_CODESTRAL_7B_V0_1_GGUF_REVISION=d9d15af238175d5697f0ca4ca64fcd0d514d2fe6
export RC_RULE_ENGINE=1             # enable .reasoning-core/rules.yaml symbolic gate
export RC_PROJECT_INDEX=1           # enable project_fan_in / project_coupling dims
export RC_DIFF_AUDIT=1              # post-turn unified-diff structural audit


# --- summary -----------------------------------------------------------------
# Visible feedback on `cd` so you know the env loaded.
echo "[direnv] reasoning-core env loaded:"
echo "         python: $(command -v python3 2>/dev/null || echo 'not found')"
echo "         S2_FAIL_CLOSED=$S2_FAIL_CLOSED  S2_TIMEOUT=$S2_TIMEOUT  S2_HARD_CAP_MS=$S2_HARD_CAP_MS"
echo "         RC_MODE=$RC_MODE  RC_SHADOW_MODE=$RC_SHADOW_MODE  RC_PLAN_BLOCK=$RC_PLAN_BLOCK"
echo "         iter-3 levers: RC_BEST_EFFORT_SPEC=$RC_BEST_EFFORT_SPEC RC_PLAN_GROUNDING=$RC_PLAN_GROUNDING RC_RULE_ENGINE=$RC_RULE_ENGINE"
echo "         ANTHROPIC_BASE_URL=${ANTHROPIC_BASE_URL:-<unset>}"
