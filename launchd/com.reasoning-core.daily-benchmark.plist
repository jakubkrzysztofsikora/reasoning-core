<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.reasoning-core.daily-benchmark</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/scripts/daily-benchmark.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <!-- Daily at 06:17 local time — off-peak for agent sessions. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>17</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/rc-daily-benchmark.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/rc-daily-benchmark.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>CLAUDE_PROJECT_DIR</key>
        <string>__REPO__</string>
    </dict>
</dict>
</plist>
